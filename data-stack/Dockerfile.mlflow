FROM python:3.12-slim

RUN pip install --no-cache-dir "mlflow==3.16.1" psycopg2-binary boto3

EXPOSE 5000
ENTRYPOINT ["mlflow", "server", "--host", "0.0.0.0", "--port", "5000", \
            "--backend-store-uri", "postgresql+psycopg2://airflow:airflow@postgres:5432/mlflow", \
            "--artifacts-destination", "s3://mlflow", \
            "--allowed-hosts", "*"]
