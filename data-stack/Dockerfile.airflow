FROM apache/airflow:2.11.0-python3.11
COPY requirements-airflow.txt /tmp/requirements.txt
# Ограничения Airflow нужны провайдерам; ML-стек фиксируем отдельно,
# чтобы сериализация sklearn в Jupyter и в задачах совпадала.
RUN pip install --no-cache-dir 'apache-airflow==2.11.0' \
    --constraint 'https://raw.githubusercontent.com/apache/airflow/constraints-2.11.0/constraints-3.11.txt' \
    apache-airflow-providers-amazon apache-airflow-providers-postgres && \
    pip install --no-cache-dir 'apache-airflow==2.11.0' -r /tmp/requirements.txt
